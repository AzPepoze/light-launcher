{
	"name": "light-launcher",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"description": "Ultra-lightweight, customizable Linux gaming launcher powered by Go & Svelte",
	"scripts": {
		"dev:go": "go build -o bin/light-launcher ./core/cmd/launcher",
		"dev:renderer": "cd src/renderer && bun run dev",
		"dev:server": "./bin/light-launcher --dev-token dev --port 9246",
		"dev": "bun run dev:go && concurrently -k \"bun run dev:renderer\" \"bun run dev:server\"",
		"build:go": "go build -ldflags=\"-s -w\" -o bin/light-launcher ./core/cmd/launcher && go build -ldflags=\"-s -w\" -o bin/light-launcher-instance ./core/cmd/instance",
		"build:renderer": "cd src/renderer && bun run build",
		"build": "bun run build:go && bun run build:renderer",
		"typecheck": "tsc --noEmit && cd src/renderer && svelte-check --tsconfig ./tsconfig.json",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"material-icons": "^1.13.14"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tsconfig/svelte": "^5.0.6",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^4.1.10",
		"concurrently": "^9.1.2",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"sass": "^1.97.3",
		"svelte": "^5.49.1",
		"svelte-check": "^4.3.6",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.10"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"svelte-preprocess"
	]
}

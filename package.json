{
  "name": "light-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Ultra-lightweight, customizable Linux gaming launcher powered by Go & Electron",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:go": "go build -o bin/light-launcher-instance ./core/cmd/instance",
    "dev:renderer": "cd src/renderer && vite",
    "dev:electron": "tsc -p src/main/tsconfig.json && tsc -p src/preload/tsconfig.json && electron .",
    "dev": "npm run dev:go && electron-vite dev || (concurrently \"npm run dev:renderer\" \"npm run dev:electron\")",
    "build:go": "go build -ldflags=\"-s -w\" -o bin/light-launcher-instance ./core/cmd/instance",
    "build:renderer": "cd src/renderer && vite build",
    "build:electron": "tsc -p src/main/tsconfig.json && tsc -p src/preload/tsconfig.json",
    "build": "npm run build:go && npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --config build/electron-builder.yml",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./src/renderer/tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^25.6.0",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "sass": "^1.97.3",
    "svelte": "^5.49.1",
    "svelte-check": "^4.3.6",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}

{
	"name": "light-launcher",
	"version": "1.0.0",
	"private": true,
	"description": "Ultra-lightweight, customizable Linux gaming launcher powered by Go & Svelte",
	"license": "MIT",
	"scripts": {
		"build": "bun run build:launcher && bun run build:instance",
		"build:instance": "mkdir -p bin && go build -ldflags=\"-s -w\" -o bin/light-launcher-instance$(go env GOEXE) ./core/cmd/instance",
		"build:launcher": "bash scripts/build-launcher.sh bin/light-launcher$(go env GOEXE)",
		"build:linux": "bun run build && bun run build:shell",
		"build:renderer": "cd src/renderer && bun run build",
		"build:shell": "mkdir -p bin && cd shell/gtk && go build -ldflags=\"-s -w\" -o ../../bin/light-launcher-shell .",
		"clean": "rm -rf bin dist src/renderer/dist core/cmd/launcher/ui",
		"dev": "concurrently -k \"bun run dev:renderer\" \"bun run dev:server\"",
		"dev:renderer": "cd src/renderer && bun run dev",
		"dev:server": "go run ./core/cmd/launcher --no-shell --dev-token dev --port 9246 --ui src/renderer",
		"e2e": "go test -tags e2e -count=1 ./core/cmd/launcher/...",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "bun run lint:ui && bun run lint:go",
		"lint:fix": "oxlint --fix",
		"lint:go": "go vet ./core/...",
		"lint:ui": "oxlint",
		"test": "bun run test:ui && bun run test:go",
		"test:coverage": "vitest run --coverage",
		"test:go": "go test -count=1 ./core/...",
		"test:ui": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && cd src/renderer && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"material-icons": "^1.13.14"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tsconfig/svelte": "^5.0.6",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^4.1.10",
		"concurrently": "^9.1.2",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"sass": "^1.97.3",
		"svelte": "^5.49.1",
		"svelte-check": "^4.3.6",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.10"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"svelte-preprocess"
	]
}

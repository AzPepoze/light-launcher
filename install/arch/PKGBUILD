# Maintainer: AzPepoze

pkgname=light-launcher
pkgver=r0.git
pkgrel=1
pkgdesc="Ultra-lightweight, customizable Linux gaming launcher powered by Go and Qt"
arch=('x86_64')
url="https://github.com/AzPepoze/light-launcher"
license=('GPL3')
depends=('umu-launcher' 'qt6-webengine')
makedepends=('git' 'go' 'bun' 'qt6-base' 'qt6-webengine')
optdepends=(
  'steam: run games with Steam Proton versions'
  'protonplus: recommended for managing Proton versions'
  'mangohud: performance overlay'
  'gamescope: micro-compositor'
  'gamemode: gaming performance optimizer'
)

source=(
  "$pkgname::git+https://github.com/AzPepoze/light-launcher.git#branch=main"
)
sha256sums=('SKIP')

_setup_go_env() {
  local _golang_workspace_path="${srcdir}/go-path"
  local _golang_module_cache_path="${srcdir}/go-mod-cache"
  local _golang_build_cache_path="${srcdir}/go-build-cache"

  mkdir -p \
    "$_golang_workspace_path/bin" \
    "$_golang_module_cache_path" \
    "$_golang_build_cache_path"

  export GOPATH="$_golang_workspace_path"
  export GOMODCACHE="$_golang_module_cache_path"
  export GOCACHE="$_golang_build_cache_path"

  # Go makes module cache directories read-only by default. Keep this cache
  # writable because it lives under $srcdir and AUR helpers remove that build
  # tree during cleanup after upgrades.
  if [[ " ${GOFLAGS:-} " != *" -modcacherw "* ]]; then
    export GOFLAGS="${GOFLAGS:+${GOFLAGS} }-modcacherw"
  fi

  export PATH="${GOPATH}/bin:${PATH}"
}

pkgver() {
  cd "$srcdir/$pkgname"
  printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/$pkgname"

  _setup_go_env

  local _bun_install_cache_path="${srcdir}/bun-cache"
  mkdir -p "$_bun_install_cache_path"
  export BUN_INSTALL_CACHE_DIR="$_bun_install_cache_path"

  bun install
  bash scripts/build-linux.sh

  go clean -modcache 2>/dev/null || true
  rm -rf "$srcdir/go-path" "$srcdir/go-build-cache" "$_bun_install_cache_path"
}

package() {
  cd "$srcdir/$pkgname"

  # The launcher starts light-launcher-instance and light-launcher-shell from its own folder.
  install -dm755 "$pkgdir/usr/lib/$pkgname"
  cp -a dist/linux/light-launcher dist/linux/light-launcher-instance dist/linux/light-launcher-shell \
    "$pkgdir/usr/lib/$pkgname/"

  install -dm755 "$pkgdir/usr/bin"
  ln -sf "/usr/lib/$pkgname/light-launcher" "$pkgdir/usr/bin/light-launcher"

  install -Dm644 "install/arch/light-launcher.desktop" "$pkgdir/usr/share/applications/light-launcher.desktop"
  install -Dm644 "build/icon.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/light-launcher.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

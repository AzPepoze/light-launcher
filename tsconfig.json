{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": false,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*"],
	"exclude": ["src/renderer/**/*", "dist", "bin", "node_modules"]
}

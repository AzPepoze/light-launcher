{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"resolveJsonModule": true,
		"moduleResolution": "bundler",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": false,
		"isolatedModules": true,
		"jsx": "preserve",
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"@shared": ["../shared/index.ts"],
			"@shared/*": ["../shared/*"],
			"@components/*": ["./src/components/*"],
			"@lib/*": ["./src/lib/*"],
			"@stores/*": ["./src/stores/*"],
			"@icons/*": ["./src/icons/*"]
		}
	},
	"include": [
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"vite.config.ts",
		"../shared/**/*.ts"
	]
}
